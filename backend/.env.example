# Forsa Backend Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# Used for: opportunity verification (gemini-2.5-flash) and chatbot (gemini-2.5-flash-lite)
# If not set, the app falls back to rule-based logic automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default: 4567)
# PORT=4567
